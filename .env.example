ENV=development
PROJECT_NAME=DTAnalitycs Data Analytic Studio Engine

# sqlite | postgresql
DB_TYPE=sqlite
DB_NAME=dtanalitycs_studio.db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
MAX_PREVIEW_ROWS=500
MAX_UPLOAD_MB=50
AUTO_CREATE_TABLES=true

# SECURITY: set false di production (node Python Script akan ditolak)
ALLOW_PYTHON_SCRIPT=true
# SECURITY: false = node reader hanya boleh membaca file di storage/uploads
ALLOW_EXTERNAL_SOURCE_PATH=false
